# Copy to .env. Never commit .env.
# Every one of these is read in exactly one place: packages/nexus-config/src/nexus_config/settings.py

# --- Agent-layer LLM ---
# Provider-agnostic: any OpenAI-compatible Chat Completions endpoint works. The default below is a local
# Ollama, so the whole stack runs with no account and no key anywhere. See ADR-0005.
#
# The model needs tool-calling support — that is the one hard requirement.
#
#   Local Ollama      http://localhost:11434/v1        (key: none)   qwen2.5:7b, llama3.1:8b
#   Ollama in Docker  http://host.docker.internal:11434/v1
#   LM Studio         http://localhost:1234/v1         (key: none)
#   llama.cpp server  http://localhost:8080/v1         (key: none)
#   vLLM              http://localhost:8000/v1         (key: none)
#   OpenRouter        https://openrouter.ai/api/v1     (key: needed) has a free tier
#   Groq              https://api.groq.com/openai/v1   (key: needed) has a free tier
#   OpenAI            https://api.openai.com/v1        (key: needed)
#   Anthropic         https://api.anthropic.com/v1     (key: needed) OpenAI-compat endpoint
NEXUS_LLM_BASE_URL=http://localhost:11434/v1
NEXUS_LLM_MODEL=qwen2.5:7b
NEXUS_LLM_API_KEY=
NEXUS_LLM_TEMPERATURE=0.0
NEXUS_LLM_TIMEOUT_SECONDS=120

# --- Service discovery ---
NEXUS_SIMULATOR_URL=http://localhost:8000
NEXUS_CONTROLLER_URL=http://localhost:8001

# --- Controller ---
# Path to a trained checkpoint. Leave empty to fall back to the `static` baseline allocator — the stack
# runs fine without a trained policy, and /health reports which allocator is live.
# Which policy the controller serves: a registry stage ('production', 'shadow') or a pin ('v7').
# Unset runs the static baseline, which /health reports. See docs/operations/model-registry.md.
NEXUS_POLICY_VERSION=

# Escape hatch: load a checkpoint directly, bypassing the registry. Carries no provenance, and is
# ignored when NEXUS_POLICY_VERSION is set. Prefer registering the run.
NEXUS_POLICY_PATH=

# --- Simulation ---
NEXUS_SEED=1337
NEXUS_TOPOLOGY=mesh-6

# --- Runtime ---
NEXUS_ENV=development
NEXUS_LOG_LEVEL=INFO

# Shared key guarding mutating endpoints. Required when NEXUS_ENV != development.
# Unrelated to NEXUS_LLM_API_KEY.
NEXUS_API_KEY=
