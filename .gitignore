# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
.vite/

# Run artifacts — never commit checkpoints or metrics dumps.
# Preserve numbers in docs/evaluation/results.md instead.
experiments/runs/*
!experiments/runs/.gitkeep

# experiments/registry/ is deliberately NOT ignored. It holds provenance metadata only — a few hundred
# bytes per policy — and it is the answer to "what is deployed and where did it come from". Ignoring it
# alongside the weights would mean that answer dies with the machine. See ADR-0009.
*.zip
*.pt
*.ckpt
tensorboard/

# Secrets
.env
.env.local
*.pem

# Editors / OS
.DS_Store
.idea/
*.swp

# Claude local overrides
.claude/settings.local.json
